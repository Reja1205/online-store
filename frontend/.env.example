# Copy to .env.local and restart `npm run dev`.
# Vercel: add the same variable in Project → Settings → Environment Variables (then redeploy).

# Your Render (or other) API root — no trailing slash. Must be HTTPS if the site is HTTPS.
NEXT_PUBLIC_API_URL=https://online-store-7kh8.onrender.com

# Optional: canonical site URL for Open Graph / metadata
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Stripe publishable key (when backend STRIPE_SECRET_KEY is set)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
