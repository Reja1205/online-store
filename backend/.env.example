# Server
PORT=4000
NODE_ENV=development

# MongoDB (Atlas connection string)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/online-store?retryWrites=true&w=majority
# MONGODB_URI=  # alias also supported

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
COOKIE_NAME=token
REFRESH_COOKIE_NAME=refresh_token
ADMIN_SECRET=optional-admin-register-secret
ADMIN_ALERT_EMAIL=security@yourstore.com

# Email verification (set true in production after SMTP is configured)
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFY_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1
PASSWORD_MIN_LENGTH=8

# Account lockout (brute-force protection)
ACCOUNT_LOCK_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Rate limiting (in-memory; use Redis proxy in multi-instance prod)
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_STRICT_MAX=10

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Checkout & shipping
SHIPPING_STANDARD_USD=5.99
SHIPPING_EXPRESS_USD=12.99
FREE_SHIPPING_MIN_USD=35
SHIPPING_FEE_USD=5.99
FRONTEND_URL=http://localhost:3000
STORE_NAME=Western Culture

# Stripe (optional — without keys, checkout uses mock payment)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...  # frontend .env.local

# Email confirmations (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=app-password
# STORE_EMAIL_FROM=orders@yourstore.com
# SMTP_SEND_TIMEOUT_MS=12000

# Recommended on Render (Gmail SMTP often times out on cloud hosts):
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=onboarding@resend.dev
# EMAIL_PROVIDER=resend

# SMS confirmations (optional — Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1234567890

# CORS — production: set your Vercel URL(s), comma-separated
# ALLOWED_ORIGINS=https://online-store-six-gules.vercel.app,https://your-custom-domain.com
#
# LAN dev (http://192.168.x.x:3000) is allowed automatically for private IPs on ports 3000/3001.
# All *.vercel.app preview URLs are allowed automatically.

# Optional: OpenAI for /api/ai
# OPENAI_API_KEY=
