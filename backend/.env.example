# Server
PORT=4000
NODE_ENV=development

# MongoDB (Atlas connection string)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/online-store?retryWrites=true&w=majority
# MONGODB_URI=  # alias also supported

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=token
ADMIN_SECRET=optional-admin-register-secret

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Checkout
SHIPPING_FEE_USD=5.99

# CORS — production: set your Vercel URL(s), comma-separated
# ALLOWED_ORIGINS=https://online-store-six-gules.vercel.app,https://your-custom-domain.com
#
# LAN dev (http://192.168.x.x:3000) is allowed automatically for private IPs on ports 3000/3001.
# All *.vercel.app preview URLs are allowed automatically.

# Optional: OpenAI for /api/ai
# OPENAI_API_KEY=
