cat >> .gitignore << 'EOF'
# Node / Next.js
node_modules/
.next/
out/
dist/
build/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/
.idea/

# Local generated product images (uploaded to Cloudinary via backend/scripts)
frontend/public/product-images/
EOF
